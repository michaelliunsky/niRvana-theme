{
  "components": {
    "site_view": {
      "template": "<div class=\"favlink-card\" style=\"\nborder-top-width: 3px;\nborder-top-style:solid;\nline-height:1.43;\nbox-shadow: 0 1px 5px rgba(215,221,230,.25),1px 0 0 #e5e9f2 inset,-1px 0 0 #e5e9f2 inset,0 -1px 0 #e5e9f2 inset;\nbackground-color:#fff;\nheight: 130px;\nwidth: 250px;\npadding: 20px 15px;\ntext-align: center;\nposition: relative;\nbox-sizing:border-box;\ncursor: pointer;\n\" :style=\"{'border-top-color':_('site_color')}\">\n\t<a class=\"title\" style=\"font-size: 15px;\n\tcolor: #475669;\">Site Title</a>\n\t<div class=\"description\" style=\"font-size: 13px;\n\tcolor: #99a9bf;\">{{_('site_description')}}</div>\n\t<a v-if=\"_('site_icon')\"\n\tclass=\"icon\"\n\t:style=\"{\n\t\t'background-color': _('site_color'),\n\t\t'box-shadow': '0 3px 8px '+ _('site_color'),\n\t\t'background-image': 'url('+_('site_icon')+')',\n\t\t'background-size': _('site_icon_width')+'px '+ _('site_icon_height')+'px'\n\t}\"\n\tstyle=\"\tposition: absolute;\n\twidth: 65px;\n\theight: 65px;\n\tcolor: #fff;\n\ttext-shadow: 0 3px 5px rgba(0,0,0,.25);\n\tfont-size: 25px;\n\tdisplay: flex;\n\talign-items: center;\n\ttext-align: center;\n\tjustify-content: center;\n\tborder-radius: 33px;\n\tleft: 50%;\n\tmargin-left: -33px;\n\tbottom: -20px;\n\tbackground-size: 65px 65px;\n\tbackground-repeat: no-repeat;\n\tbackground-position: center;\"></a>\n\t<a v-else\n\tclass=\"icon\"\n\t:style=\"{'background-color': _('site_color'),'box-shadow': '0 3px 8px '+ _('site_color'),'background-image': 'url('+_('site_icon')+')'}\"\n\tstyle=\"\tposition: absolute;\n\twidth: 65px;\n\theight: 65px;\n\tcolor: #fff;\n\ttext-shadow: 0 3px 5px rgba(0,0,0,.25);\n\tfont-size: 25px;\n\tdisplay: flex;\n\talign-items: center;\n\ttext-align: center;\n\tjustify-content: center;\n\tborder-radius: 33px;\n\tleft: 50%;\n\tmargin-left: -33px;\n\tbottom: -20px;\">Site</a>\n</div>",
      "inject": {},
      "methods": {}
    }
  },

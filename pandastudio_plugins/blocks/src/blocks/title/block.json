{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pandastudio/title",
	"version": "2.0.0",
	"title": "小标题",
	"icon": "feedback",
	"category": "pandastudio-block-category",
	"attributes": {
		"content": {
			"type": "string",
			"source": "html",
			"selector": "p,h2,h3"
		},
		"titleClass": {
			"type": "string",
			"source": "attribute",
			"selector": "[class^='title_style']",
			"attribute": "class",
			"default": "title_style_01"
		},
		"titleInnerTag": {
			"type": "string",
			"default": "p"
		}
	},
	"supports": {
		"html": false
	}
}
